  padding-bottom: 4rpx;
}

.landscape-tab.active {
  color: #ffffff;
  font-weight: 700;
}

.landscape-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #ff5f9d;
  transform: translateX(-50%);
}

.landscape-swiper {
