}

.landscape-banner-image {
  display: block;
  width: 100%;
  height: 100%;
}

.landscape-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 132rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.68) 100%);
}

.landscape-banner-copy {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 1;
  color: #ffffff;
}

.landscape-banner-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.landscape-banner-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.86);
}

.landscape-name {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.landscape-desc {
  margin-top: 3rpx;
  font-size: 20rpx;
