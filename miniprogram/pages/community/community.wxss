.publish-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.publish-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.publish-menu {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.publish-menu.show {
  transform: translateY(0);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  margin-bottom: 16rpx;
}

.menu-item:last-child {
  margin-bottom: 0;
}

.menu-item:active {
  background: #eef1f2;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #69ccc5 0%, #4db8b0 100%);
  flex-shrink: 0;
}

.menu-text {
  color: #1c2a2b;
  font-size: 30rpx;
  font-weight: 600;
}

.post-symbol {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.post-symbol-play {
  position: absolute;
  left: 4rpx;
  top: 2rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 12rpx 0 12rpx 20rpx;
  border-color: transparent transparent transparent #ffffff;
}

.template-symbol {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.template-symbol-grid {
  width: 28rpx;
  height: 28rpx;
  background: #ffffff;
  border-radius: 4rpx;
  box-shadow: 
    -4rpx -4rpx 0 #ffffff,
    4rpx -4rpx 0 #ffffff,
    -4rpx 4rpx 0 #ffffff,
    4rpx 4rpx 0 #ffffff;
}

/* ===== 以下完全复制 ref.wxss，不修改任何内容 ===== */
.refresh-ring {
  display: none !important;
}

.refresh-arc {
  position: absolute ;
  left: 3rpx ;
  width: 13rpx ;
  height: 7rpx ;
  border: 3rpx solid #18252d ;
  box-sizing: border-box ;
  background: transparent ;
}

.refresh-arc-top {
  top: 2rpx ;
  border-bottom: 0 ;
  border-radius: 13rpx 13rpx 0 0 ;
}

.refresh-arc-bottom {
  bottom: 2rpx ;
  border-top: 0 ;
  border-radius: 0 0 13rpx 13rpx ;
}

.refresh-arrow {
  position: absolute !important;
  width: 6rpx !important;
  height: 6rpx !important;
  background: #18252d !important;
  clip-path: polygon(0 0, 100% 50%, 0 100%) !important;
}

.refresh-arrow-one {
  right: 0 !important;
  top: 5rpx !important;
  transform: rotate(90deg) !important;
}

.refresh-arrow-two {
  left: 0 !important;
  bottom: 5rpx !important;
  transform: rotate(270deg) !important;
}

page {
  min-height: 100vh;
  background: #fff8ec;
  color: #15252a;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 138rpx 28rpx 132rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    linear-gradient(180deg, #fff8ec 0 138rpx, #d2f0eb 138rpx 100%),
    #fff8ec;
}

.top-dock-wrapper {
  position: fixed;
  top: calc(10rpx + env(safe-area-inset-top));
  right: 60rpx;
  z-index: 20;
  width: 300rpx;   /* ← 新增这一行 */
}
.dock-label-row {
  display: flex;
  justify-content: space-around;
  padding: 0 22rpx;
  margin-bottom: 6rpx;
}

.dock-label {
  width: 58rpx;
  text-align: center;
  color: rgba(80, 90, 95, 0.56);
  font-size: 25rpx;
  line-height: 1.2;
}

.dock-label.active {
  color: #68c9c4;
  font-weight: 600;
}

.top-dock {
  width: 300rpx;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 253, 247, 0.98);
