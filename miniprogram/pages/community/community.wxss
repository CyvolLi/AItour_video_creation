  border: 3rpx solid #18252d;
  border-right-color: transparent;
  border-radius: 50%;
  box-sizing: border-box;
}

.refresh-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 14rpx;
  height: 14rpx;
  border: 0;
}

.refresh-ring::before,
.refresh-ring::after {
  content: "";
  position: absolute;
  left: 1rpx;
  top: 1rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #18252d;
  border-radius: 50%;
  box-sizing: border-box;
}

.refresh-ring::before {
  border-right-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(20deg);
}

.refresh-ring::after {
  border-left-color: transparent;
  border-top-color: transparent;
  transform: rotate(20deg);
}

.refresh-arrow-one {
  right: -1rpx;
  top: 1rpx;
  transform: rotate(30deg);
}

.refresh-arrow-two {
  left: -1rpx;
  bottom: 1rpx;
  transform: rotate(210deg);
}

.refresh-ring::before,
.refresh-ring::after {
  border-color: transparent;
}

.refresh-ring::before {
  border-top-color: #18252d;
  border-left-color: #18252d;
  transform: rotate(28deg);
}

.refresh-ring::after {
  border-right-color: #18252d;
  border-bottom-color: #18252d;
  transform: rotate(28deg);
}

.refresh-ring::before,
.refresh-ring::after {
  left: 1rpx;
  top: 1rpx;
  width: 12rpx;
  height: 12rpx;
  border: 0;
  border-top: 3rpx solid #18252d;
  border-radius: 50%;
  box-sizing: border-box;
}

