  border-radius: 34rpx;
  background: #bfe8e3;
  box-shadow:
    0 14rpx 24rpx rgba(43, 91, 92, 0.18),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.32);
  box-sizing: border-box;
}

.columns {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.column {
  flex: 1;
  min-width: 0;
}

.column.offset {
  padding-top: 18rpx;
}

.content-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 7rpx solid #ffffff;
  border-radius: 27rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 14rpx rgba(34, 58, 59, 0.23);
  box-sizing: border-box;
}

.cover {
  display: block;
  width: 100%;
  height: 266rpx;
  border-radius: 18rpx;
  background: #d3eee9;
}

.content-card.short .cover {
  height: 214rpx;
}

.play-dot {
  position: absolute;
  top: 18rpx;
  right: 14rpx;
  width: 0;
  height: 0;
  border-top: 17rpx solid transparent;
  border-bottom: 17rpx solid transparent;
  border-left: 22rpx solid rgba(255, 255, 255, 0.96);
  filter: drop-shadow(0 2rpx 5rpx rgba(0, 0, 0, 0.22));
