.landscape-carousel {
  display: none;
}

.landscape-hero {
  position: relative;
  z-index: 2;
  margin: 0 -10rpx 24rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 34rpx;
  background: #111315;
  box-shadow: 0 18rpx 30rpx rgba(0, 0, 0, 0.26);
  box-sizing: border-box;
}

.landscape-tabs {
  height: 58rpx;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.landscape-track {
  display: flex;
  align-items: center;
  gap: 26rpx;
  min-width: 100%;
  height: 58rpx;
  box-sizing: border-box;
}

.landscape-tab {
  position: relative;
  flex: 0 0 auto;
  color: rgba(255, 255, 255, 0.68);
  font-size: 30rpx;
