page {
  min-height: 100vh;
  background: #e7f8e6;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 150rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e7f8e6 0%, #d5f5f2 100%);
}

.panel,
.empty-panel {
  width: 100%;
}

.empty-panel {
  margin-top: 112rpx;
  padding: 38rpx 36rpx 44rpx;
  border-radius: 34rpx;
  background: rgba(205, 242, 255, 0.92);
  box-shadow: 0 8rpx 14rpx rgba(50, 74, 71, 0.22);
  box-sizing: border-box;
  text-align: center;
}

.empty-illustration {
  position: relative;
  width: 230rpx;
  height: 148rpx;
  margin: 0 auto 24rpx;
}

.scenery-card {
  position: absolute;
  left: 16rpx;
  top: 8rpx;
  z-index: 2;
  width: 198rpx;
  height: 124rpx;
  overflow: hidden;
  border: 8rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 34rpx;
  background: linear-gradient(180deg, #e8fbff 0%, #c8f1f1 56%, #a8e2c8 57%, #73cfae 100%);
  box-shadow:
    0 12rpx 18rpx rgba(53, 128, 128, 0.2),
    inset 0 -8rpx 16rpx rgba(46, 148, 137, 0.12);
  box-sizing: border-box;
  transform: rotate(-1deg);
}

.scenery-sun {
  position: absolute;
  top: 18rpx;
  right: 30rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ffd879;
  box-shadow: 0 0 16rpx rgba(255, 216, 121, 0.62);
}

.scenery-cloud {
  position: absolute;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
}

.cloud-one {
  left: 26rpx;
  top: 24rpx;
  width: 46rpx;
}

.cloud-two {
  left: 74rpx;
  top: 38rpx;
  width: 34rpx;
  opacity: 0.74;
}

.scenery-mountain {
  position: absolute;
  bottom: 34rpx;
  border-radius: 999rpx 999rpx 18rpx 18rpx;
  transform: rotate(-7deg);
}

.mountain-back {
  left: 18rpx;
  width: 118rpx;
  height: 48rpx;
  background: #8cdbd2;
}

.mountain-front {
  right: 12rpx;
  bottom: 30rpx;
  width: 132rpx;
  height: 62rpx;
  background: #55c6bd;
  transform: rotate(-10deg);
}

.scenery-field {
  position: absolute;
  left: -8rpx;
  right: -8rpx;
  bottom: -12rpx;
  height: 58rpx;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, #94dfc4 0%, #62c3a6 100%);
}

.scenery-path {
  position: absolute;
  left: 92rpx;
  bottom: -4rpx;
  width: 30rpx;
  height: 62rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 239, 190, 0.76), rgba(246, 211, 133, 0.66));
  transform: perspective(90rpx) rotateX(22deg) rotate(4deg);
  transform-origin: bottom center;
}

.spark {
  position: absolute;
  z-index: 3;
  width: 12rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #ffd879;
  transform: rotate(45deg);
  box-shadow: 0 0 12rpx rgba(255, 216, 121, 0.58);
}

.spark-one {
  top: 13rpx;
  right: 14rpx;
}

.postcard-shadow {
  position: absolute;
  left: 34rpx;
  right: 32rpx;
  bottom: 0;
  z-index: 1;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(51, 116, 117, 0.12);
  filter: blur(2rpx);
}

.empty-title {
  color: #18252d;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.empty-desc {
  margin-top: 16rpx;
  color: #738388;
  font-size: 27rpx;
  line-height: 1.55;
}

.media-frame {
  width: 100%;
  height: 466rpx;
  padding: 10rpx;
  border-radius: 48rpx;
  background: #b6b8b8;
  box-sizing: border-box;
  overflow: hidden;
}

.video {
  width: 100%;
  height: 100%;
  border-radius: 38rpx;
  background: #d9eee7;
}

.content-box {
  width: 100%;
  min-height: 314rpx;
  margin-top: 72rpx;
  padding: 34rpx 28rpx;
  border-radius: 42rpx;
  background: #cdf3ff;
  box-shadow: 0 8rpx 12rpx rgba(58, 73, 70, 0.24);
  box-sizing: border-box;
}

.title-input {
  width: 100%;
  height: 72rpx;
  color: #18252d;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 72rpx;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 14rpx;
  color: #18252d;
  font-size: 34rpx;
  line-height: 1.45;
}

.title-placeholder,
.text-placeholder {
  color: #9b9fa4;
}

.option-pill {
  display: flex;
  align-items: center;
  width: 100%;
  height: 100rpx;
  margin-top: 40rpx;
  padding: 0 58rpx;
  border-radius: 52rpx;
  background: #9cd9fb;
  box-shadow: 0 8rpx 10rpx rgba(58, 73, 70, 0.22);
  box-sizing: border-box;
}

.option-pill + .option-pill {
  margin-top: 32rpx;
}

.option-icon {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  margin-right: 34rpx;
}

.location-input,
.option-text {
  flex: 1;
  height: 100rpx;
  color: #0f171d;
  font-size: 34rpx;
  line-height: 100rpx;
}

.option-placeholder {
  color: #0f171d;
}

.endorsement-option {
  justify-content: space-between;
  height: 116rpx;
  padding-right: 38rpx;
}

.endorsement-labels {
  min-width: 0;
}

.endorsement-title-line {
  display: flex;
  align-items: center;
}

.endorsement-option-text {
  flex: 0 1 auto;
  height: auto;
  line-height: 1.2;
}

.demo-badge,
.match-badge {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #257da8;
  font-size: 22rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.72);
}

.endorsement-hint {
  display: block;
  margin-top: 8rpx;
  color: #4c727d;
  font-size: 23rpx;
}

.endorsement-switch {
  flex: 0 0 auto;
  margin-left: 18rpx;
  transform: scale(0.84);
  transform-origin: right center;
}

.endorsement-preview {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 256rpx;
  margin-top: 24rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(61, 147, 195, 0.16);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 14rpx rgba(58, 73, 70, 0.14);
  box-sizing: border-box;
}

.endorsement-image {
  flex: 0 0 auto;
  border-radius: 22rpx;
  background: #d9eee7;
}

.endorsement-image-large {
  width: 220rpx;
  height: 220rpx;
}

.endorsement-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.endorsement-tags {
  display: flex;
  align-items: center;
}

.endorsement-market {
  flex: 0 0 auto;
  padding: 6rpx 13rpx;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  background: #49a986;
}

.endorsement-product-title {
  overflow: hidden;
  margin-top: 14rpx;
  color: #18252d;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.endorsement-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.endorsement-price {
  font-size: 30rpx;
  font-weight: 800;
}

.endorsement-price-demo {
  color: #ed5b3d;
}

.endorsement-sales {
  margin-left: 16rpx;
  color: #839194;
  font-size: 21rpx;
}

.match-badge {
  color: #2c8b70;
  background: #e4f7ed;
}

.endorsement-note {
  margin-top: 8rpx;
  color: #718187;
  font-size: 22rpx;
}

.main-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  padding: 0;
  border: 0;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
  background: #3d93c3;
  box-shadow: 0 8rpx 10rpx rgba(53, 79, 89, 0.24);
}

.empty-main-btn {
  position: relative;
  width: 430rpx;
  height: 90rpx;
  margin: 34rpx auto 0;
  border-radius: 48rpx;
  font-size: 36rpx;
  background: linear-gradient(180deg, #58b9dc 0%, #3494c4 54%, #287caf 100%);
  box-shadow:
    0 14rpx 22rpx rgba(45, 130, 169, 0.32),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.22),
    inset 0 -4rpx 8rpx rgba(29, 93, 132, 0.18);
  overflow: hidden;
}

.empty-btn-icon {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
}

.publish-btn {
  width: 496rpx;
  margin: 38rpx auto 0;
}

.main-btn::after,
.sub-btn::after {
  border: 0;
}

.sub-btn {
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #18252d;
  font-size: 30rpx;
}

.empty-sub-btn {
  width: 390rpx;
  height: 76rpx;
  margin: 26rpx auto 0;
  border: 2rpx solid rgba(124, 141, 146, 0.28);
  color: #5f7075;
  font-size: 30rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: none;
}
