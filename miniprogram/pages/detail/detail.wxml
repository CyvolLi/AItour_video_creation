<view class="page">
  <view class="hero" wx:if="{{type === 'post'}}">
    <video class="video" src="{{item.video_url}}" poster="{{item.cover_url}}" controls></video>
    <view class="title">{{item.title || '旅行作品'}}</view>
    <view class="author-line">
      <image class="author-avatar" wx:if="{{item.author_avatar}}" src="{{item.author_avatar}}" mode="aspectFill" binderror="refreshDetailAvatarOnError"></image>
      <text class="author">{{item.author_name || '忆景创影'}}</text>
    </view>
  </view>

  <view class="hero" wx:else>
    <image class="image" src="{{item.image_url}}" mode="aspectFill"></image>
    <view class="title">{{item.author_name || '用户'}}的卡片</view>
    <view class="copy">{{item.emotion_text || '暂无情绪描述'}}</view>
    <button class="main-btn" bindtap="useCard">立即使用</button>
  </view>

  <view class="target">
    <view class="stat">点赞 {{target.likes || 0}}</view>
    <view class="stat">收藏 {{target.favorites || 0}}</view>
    <view class="stat">评论 {{target.comments || 0}}</view>
  </view>

  <button class="favorite" bindtap="favoriteCurrent">收藏当前内容</button>

  <view class="detail-tabs" wx:if="{{type === 'post'}}">
    <view class="detail-tab {{activeDetailTab === 'intro' ? 'active' : ''}}" data-tab="intro" bindtap="switchDetailTab">简介</view>
    <view class="detail-tab {{activeDetailTab === 'products' ? 'active' : ''}}" data-tab="products" bindtap="switchDetailTab">同款好物·{{demoProducts.length}}</view>
    <view class="detail-tab {{activeDetailTab === 'comments' ? 'active' : ''}}" data-tab="comments" bindtap="switchDetailTab">评论</view>
  </view>

  <view class="detail-intro" wx:if="{{type === 'post' && activeDetailTab === 'intro'}}">
    <view class="section-title">作品简介</view>
    <view class="copy">{{item.share_text || '暂无视频文案'}}</view>
    <button class="main-btn" bindtap="usePostCard">使用绑定卡片</button>
  </view>

  <view class="product-grid" wx:if="{{type === 'post' && activeDetailTab === 'products'}}">
    <view class="product-card" wx:for="{{demoProducts}}" wx:key="id" bindtap="showDemoProduct" data-product-id="{{item.id}}">
      <image class="product-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-title">{{item.title}}</view>
        <view class="product-description">{{item.description}}</view>
        <view class="product-tag">演示商品 · {{item.tag}}</view>
        <view class="product-meta">
          <text class="product-price">{{item.price}}</text>
          <text class="product-sales">已售{{item.sales}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="comments" wx:if="{{type !== 'post' || activeDetailTab === 'comments'}}">
    <view class="section-title">评论</view>
    <block wx:for="{{target.List}}" wx:key="comment_id">
      <view class="comment">
        <image class="avatar" wx:if="{{item.author_avatar}}" src="{{item.author_avatar}}" mode="aspectFill" binderror="refreshCommentAvatarOnError" data-index="{{index}}"></image>
        <view class="comment-body">
          <view class="comment-name">{{item.author_name || '用户'}}</view>
          <view class="comment-content">{{item.content}}</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{commentLoading}}">评论加载中...</view>
    <view class="empty" wx:if="{{!commentLoading && (!target.List || target.List.length === 0)}}">暂无评论</view>
    
    <!-- 底部评论输入框 -->
    <view class="comment-editor-bottom">
      <textarea class="comment-input" value="{{commentInput}}" bindinput="onCommentInput" placeholder="写下你的评论" maxlength="300"></textarea>
      <image class="send-btn" src="/images/icons/send.svg" bindtap="submitComment" mode="aspectFill"></image>
    </view>
  </view>
</view>
