page {
  background: #edf9f4;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  background: #edf9f4;
  color: #202b27;
}

.custom-header {
  background: rgba(237, 249, 244, 0.96);
}

.header-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 0 0 28rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(91, 111, 103, 0.18);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 5rpx 12rpx rgba(37, 72, 61, 0.12);
}

.back-button-active {
  opacity: 0.72;
}

.back-icon {
  margin-top: -6rpx;
  color: #17201d;
  font-size: 62rpx;
  font-weight: 300;
  line-height: 1;
}

.header-title {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  height: 72rpx;
  margin-left: 18rpx;
  padding: 0 28rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #d6f1e9;
  box-shadow: 0 5rpx 12rpx rgba(37, 72, 61, 0.12);
  color: #17201d;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.content {
  padding: 16rpx 28rpx 0;
}

.post-card,
.card-view {
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(97, 141, 124, 0.18);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 20rpx rgba(42, 81, 66, 0.1);
}

.post-card {
  padding: 20rpx;
  border-radius: 30rpx;
}

.video-wrap {
  position: relative;
  width: 100%;
  height: 386rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #dce9e4;
}

.card-view {
  padding: 24rpx;
}

.video,
.image {
  display: block;
  width: 100%;
  height: 386rpx;
  border-radius: 24rpx;
  background: #dce9e4;
  object-fit: cover;
}

.author-line {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.author-avatar,
.avatar {
  flex-shrink: 0;
  border-radius: 50%;
  background: #dce9e4;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  margin-right: 16rpx;
}

.author-copy {
  display: flex;
  align-items: center;
  min-width: 0;
}

.author {
  overflow: hidden;
  color: #26332e;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.author-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 15rpx;
  background: #e2e9e6;
  color: #52605a;
  font-size: 20rpx;
}

.title {
  margin-top: 16rpx;
  color: #17201d;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.copy {
  margin-top: 10rpx;
  color: #34433d;
  font-size: 27rpx;
  line-height: 1.55;
}

.post-tags {
  margin-top: 10rpx;
  color: #528675;
  font-size: 25rpx;
  line-height: 1.45;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 8rpx;
  color: #7b8b84;
  font-size: 22rpx;
}

.main-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  margin-top: 20rpx;
  border: 0;
  border-radius: 38rpx;
  background: #bfeee7;
  box-shadow: 0 5rpx 10rpx rgba(49, 114, 101, 0.14);
  color: #31524a;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 76rpx;
}

.main-btn::after {
  border: 0;
}

.video-product-overlay {
  position: absolute;
  left: 24rpx;
  bottom: 74rpx;
  z-index: 8;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 55%;
  height: 72rpx;
  padding: 4rpx 10rpx 4rpx 4rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 4rpx 12rpx rgba(32, 53, 47, 0.12);
}

.video-product-image {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: #dce9e4;
}

.video-product-copy {
  flex: 1;
  min-width: 0;
  margin: 0 10rpx;
  color: #26332e;
}

.video-product-title {
  max-width: 220rpx;
  overflow: hidden;
  color: #24312e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-product-price {
  color: #e15d3e;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 26rpx;
}

.video-product-action {
  flex-shrink: 0;
  color: #2f7e69;
  font-size: 19rpx;
  font-weight: 700;
  white-space: nowrap;
}

.product-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(97, 141, 124, 0.2);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 6rpx 16rpx rgba(42, 81, 66, 0.1);
}

.product-media {
  flex-shrink: 0;
  width: 150rpx;
  height: 150rpx;
  border-radius: 22rpx;
  background: #dce9e4;
}

.product-copy {
  flex: 1;
  min-width: 0;
  margin: 0 14rpx;
}

.product-topline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.product-market {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #c83f3f;
  color: #fff;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.2;
}

.product-tag {
  display: inline-block;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #edf8f4;
  color: #3f8a72;
  font-size: 18rpx;
  line-height: 1.2;
}

.product-title {
  display: -webkit-box;
  min-width: 0;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #26332e;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product-description {
  display: -webkit-box;
  min-width: 0;
  margin-top: 6rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  color: #68766f;
  font-size: 20rpx;
  line-height: 1.35;
}

.product-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
  margin-top: 8rpx;
}

.product-price {
  color: #e14f3f;
  font-size: 28rpx;
  font-weight: 750;
}

.product-sales {
  overflow: hidden;
  color: #89958f;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-action {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f7e0e0;
  color: #c74b4b;
  font-size: 20rpx;
  font-weight: 700;
}

.target {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 18rpx;
  padding: 24rpx 12rpx;
  border-top: 1rpx solid rgba(113, 142, 131, 0.16);
  border-bottom: 1rpx solid rgba(113, 142, 131, 0.16);
  background: rgba(224, 247, 242, 0.62);
}

.stat {
  color: #53635d;
  font-size: 26rpx;
}

.stat-favorite {
  padding: 8rpx 16rpx;
}

.comments {
  margin-top: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.68);
}

.section-title {
  margin-bottom: 18rpx;
  color: #1f2b26;
  font-size: 30rpx;
  font-weight: 700;
}

.comment {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0 18rpx;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-name {
  margin-bottom: 7rpx;
  color: #34443e;
  font-size: 24rpx;
  font-weight: 600;
}

.comment-content {
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(101, 139, 125, 0.16);
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: rgba(255, 255, 255, 0.84);
  color: #3e4b46;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}

.empty {
  padding: 34rpx 0;
  color: #89958f;
  font-size: 24rpx;
  text-align: center;
}

.comment-error {
  color: #9a6a34;
}

.comment-editor-bottom {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 10rpx 14rpx 10rpx 20rpx;
  border: 1rpx solid rgba(101, 139, 125, 0.16);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.9);
}

.comment-input {
  flex: 1;
  min-width: 0;
  min-height: 48rpx;
  max-height: 100rpx;
  padding: 0;
  color: #34443e;
  font-size: 25rpx;
}

.send-btn {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 12rpx;
}
