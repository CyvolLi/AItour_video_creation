.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 20px;
}

.hero {
  background: #fff;
  padding: 16px;
  margin-bottom: 12px;
}

.video {
  width: 100%;
  height: 200px;
  border-radius: 12px;
  object-fit: cover;
}

.image {
  width: 100%;
  height: 200px;
  border-radius: 12px;
  object-fit: cover;
  display: block;
}

.title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin-top: 12px;
  line-height: 1.4;
}

.author-line {
  display: flex;
  align-items: center;
  margin-top: 10px;
}

.author-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  margin-right: 8px;
}

.author {
  font-size: 14px;
  color: #666;
}

.copy {
  font-size: 14px;
  color: #555;
  margin-top: 10px;
  line-height: 1.6;
}

.main-btn {
  width: 100%;
  height: 40px;
  background: #07c160;
  color: #fff;
  font-size: 15px;
  border-radius: 20px;
  margin-top: 14px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.main-btn::after {
  border: none;
}

.target {
  background: #fff;
  display: flex;
  justify-content: space-around;
  padding: 14px 16px;
  margin-bottom: 12px;
}

.stat {
  font-size: 14px;
  color: #666;
}

.favorite {
  width: 100%;
  height: 40px;
  background: linear-gradient(135deg, #1f9a9c 0%, #9c822b 100%);
  color: #fff;
  font-size: 15px;
  border: none;
  border-radius: 20px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite::after {
  border: none;
}

.detail-tabs {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 0 16px;
  margin-bottom: 12px;
  border-bottom: 1px solid #edf2ef;
}

.detail-tab {
  position: relative;
  padding: 15px 4px 13px;
  margin-right: 26px;
  color: #7a8580;
  font-size: 15px;
  font-weight: 500;
}

.detail-tab.active {
  color: #167c67;
  font-weight: 600;
}

.detail-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 28px;
  height: 3px;
  border-radius: 2px;
  background: #20a886;
  transform: translateX(-50%);
}

.detail-intro {
  background: #fff;
  padding: 16px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  padding: 24rpx;
  background: #f3f7f5;
}

.product-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e4eee9;
  border-radius: 20rpx;
  background: #fff;
}

.product-image {
  display: block;
  width: 100%;
  height: 280rpx;
  object-fit: cover;
  background: #e9efec;
}

.product-info {
  padding: 18rpx;
}

.product-title {
  display: -webkit-box;
  overflow: hidden;
  color: #202a26;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-description {
  overflow: hidden;
  margin-top: 8rpx;
  color: #7a8580;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-tag {
  display: inline-block;
  max-width: 100%;
  margin-top: 12rpx;
  padding: 4rpx 10rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8f7f2;
  color: #16866e;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 14rpx;
}

.product-price {
  color: #ef5b45;
  font-size: 30rpx;
  font-weight: 700;
}

.product-sales {
  color: #9aa39f;
  font-size: 20rpx;
}

.comments {
  background: #fff;
  padding: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  margin-bottom: 12px;
}

.comment {
  display: flex;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.comment:last-child {
  border-bottom: none;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin-right: 10px;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
}

.comment-name {
  font-size: 13px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.comment-content {
  font-size: 14px;
  color: #555;
  line-height: 1.5;
}

.empty {
  text-align: center;
  padding: 20px 0;
  font-size: 14px;
  color: #999;
}

/* 底部评论输入框 */
.comment-editor-bottom {
  display: flex;
  align-items: center;
  padding: 8px 12px;
  background: #f8f8f8;
  border-radius: 20px;
  margin-top: 12px;
}

.comment-input {
  flex: 1;
  font-size: 14px;
  border: none;
  outline: none;
  background: transparent;
  min-height: 24px;
  max-height: 60px;
  padding: 4px 0;
  resize: none;
}

.send-btn {
  width: 24px;
  height: 24px;
  margin-left: 8px;
  flex-shrink: 0;
}
